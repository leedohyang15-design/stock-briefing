[Unit]
Description=AI 트레이더 대시보드 (보기 전용, 비밀번호 보호)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/.venv/bin/python -m src.trader.web.server --host 0.0.0.0 --no-browser
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
