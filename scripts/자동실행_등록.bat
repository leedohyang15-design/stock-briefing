@echo off
REM Weekdays 07:55 paper trading + Saturday 10:00 weekly review.
REM WakeToRun: wakes the PC from sleep (not from shutdown). StartWhenAvailable: runs late if PC was off at 07:55.
set "D=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=New-ScheduledTaskSettingsSet -WakeToRun -StartWhenAvailable -ExecutionTimeLimit (New-TimeSpan -Hours 10); $a=New-ScheduledTaskAction -Execute ($env:D + 'run_trader.bat'); $t=New-ScheduledTaskTrigger -Weekly -DaysOfWeek Monday,Tuesday,Wednesday,Thursday,Friday -At 07:55; Register-ScheduledTask -TaskName 'AI Trader daily' -Action $a -Trigger $t -Settings $s -Force | Out-Null; $a2=New-ScheduledTaskAction -Execute ($env:D + 'run_weekly.bat'); $t2=New-ScheduledTaskTrigger -Weekly -DaysOfWeek Saturday -At 10:00; Register-ScheduledTask -TaskName 'AI Trader weekly' -Action $a2 -Trigger $t2 -Settings $s -Force | Out-Null; $a3=New-ScheduledTaskAction -Execute ($env:D + 'run_trader_us.bat'); $t3=New-ScheduledTaskTrigger -Weekly -DaysOfWeek Monday,Tuesday,Wednesday,Thursday,Friday -At 21:50; Register-ScheduledTask -TaskName 'AI Trader US daily' -Action $a3 -Trigger $t3 -Settings $s -Force | Out-Null; $a4=New-ScheduledTaskAction -Execute ($env:D + 'run_weekly_us.bat'); $t4=New-ScheduledTaskTrigger -Weekly -DaysOfWeek Saturday -At 10:30; Register-ScheduledTask -TaskName 'AI Trader US weekly' -Action $a4 -Trigger $t4 -Settings $s -Force | Out-Null; Write-Host 'OK: KR daily Mon-Fri 07:55 / KR weekly Sat 10:00 / US daily Mon-Fri 21:50 / US weekly Sat 10:30'"
echo.
echo Keep the PC on or in SLEEP (not shut down). Enable "wake timers" in Power Options.
pause
